# 复制为 .env 后填写。改完需重启。

# 网页后台登录密码（至少 8 位）
ADMIN_PASSWORD=change-me-please

# QQ 机器人凭据：https://q.qq.com → 机器人 → 开发管理
QQ_APP_ID=
QQ_APP_SECRET=

# 0.0.0.0 = 同一 Wi-Fi 下的手机也能打开；只给本机用则改 127.0.0.1
HOST=0.0.0.0
PORT=8787

# 有域名/内网穿透时填对外地址，用于手机二维码和 MCP 配置，如 https://fb.example.com
PUBLIC_URL=

# 前面有 HTTPS 反向代理时设 TRUST_PROXY=true；代理或穿透客户端就在本机时用 loopback 更安全
# （经 HTTPS 访问时登录 Cookie 会自动加 Secure，COOKIE_SECURE=true 则强制，局域网 HTTP 将无法登录）
TRUST_PROXY=false
COOKIE_SECURE=false

# 连续消息自动并成一条反馈的时间窗口（分钟）
MERGE_WINDOW_MINUTES=5

# 截图文字识别（本地离线）
OCR_ENABLED=true
MAX_ATTACHMENT_MB=200
# 数据库每日备份保留份数，0 为不备份
BACKUP_KEEP_DAYS=14
# DATA_DIR=data
# LOG_LEVEL=info
