# 复制为 .env 后填写。改完需重启。

# 网页后台登录密码（至少 8 位）
ADMIN_PASSWORD=change-me-please

# QQ 机器人凭据：https://q.qq.com → 机器人 → 开发管理
QQ_APP_ID=
QQ_APP_SECRET=

# 监听地址。仅本机访问用 127.0.0.1；要让局域网或反向代理访问再改 0.0.0.0
HOST=127.0.0.1
PORT=8787

# 前面有 HTTPS 反向代理时两项都设为 true
TRUST_PROXY=false
COOKIE_SECURE=false

# 连续消息自动并成一条反馈的时间窗口（分钟）
MERGE_WINDOW_MINUTES=5

# 截图文字识别（本地离线）
OCR_ENABLED=true
MAX_ATTACHMENT_MB=200
# 数据库每日备份保留份数，0 为不备份
BACKUP_KEEP_DAYS=14
# DATA_DIR=data
# LOG_LEVEL=info
